<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.pulseflow</groupId>
    <artifactId>pulseflow</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>PulseFlow</name>
    <description>Real-time User Behavior Decision Engine</description>

    <modules>
        <module>pulseflow-common</module>
        <module>pulseflow-event</module>
        <module>pulseflow-profile</module>
        <module>pulseflow-campaign</module>
        <module>pulseflow-job</module>
        <module>pulseflow-simulator</module>
        <module>pulseflow-ai</module>
        <module>pulseflow-boot</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <mybatis-plus.version>3.5.6</mybatis-plus.version>
        <mybatis-spring.version>3.0.3</mybatis-spring.version>
        <redisson.version>3.29.0</redisson.version>
        <sa-token.version>1.38.0</sa-token.version>
        <xxl-job.version>2.4.1</xxl-job.version>
        <hutool.version>5.8.27</hutool.version>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <lombok.version>1.18.32</lombok.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Internal modules -->
            <dependency>
                <groupId>com.pulseflow</groupId>
                <artifactId>pulseflow-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pulseflow</groupId>
                <artifactId>pulseflow-event</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pulseflow</groupId>
                <artifactId>pulseflow-profile</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pulseflow</groupId>
                <artifactId>pulseflow-campaign</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pulseflow</groupId>
                <artifactId>pulseflow-job</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pulseflow</groupId>
                <artifactId>pulseflow-ai</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- MyBatis-Plus -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- Redisson -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>

            <!-- Sa-Token -->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-spring-boot3-starter</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-redis-jackson</artifactId>
                <version>${sa-token.version}</version>
            </dependency>

            <!-- XXL-JOB -->
            <dependency>
                <groupId>com.xuxueli</groupId>
                <artifactId>xxl-job-core</artifactId>
                <version>${xxl-job.version}</version>
            </dependency>

            <!-- Hutool -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!-- MapStruct -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>

            <!-- Flyway MySQL: MUST align with flyway-core version managed by the
                 Spring Boot BOM (exposed as ${flyway.version}). A mismatch (e.g.
                 flyway-mysql 10.x with flyway-core 9.22.3) causes
                 AbstractMethodError: MySQLDatabase.ensureSupported() at runtime,
                 breaking FlywayMigrationIT. Pin via the BOM property to stay aligned. -->
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-mysql</artifactId>
                <version>${flyway.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- All modules get: -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            CI safety net: when running in GitHub Actions (env.GITHUB_ACTIONS=true),
            enforce that PULSEFLOW_TEST_DOCKER=true so Docker integration tests
            (Flyway migration, Kafka idempotency) are never silently skipped by a
            misconfigured pipeline. Locally, developers can still skip Docker
            tests by leaving PULSEFLOW_TEST_DOCKER unset.

            We use GITHUB_ACTIONS instead of the generic CI variable because some
            local IDEs (e.g. Trae CN) set CI=true in the shell environment, which
            would cause false-positive enforcer failures during local development.
        -->
        <profile>
            <id>ci-enforce-docker-tests</id>
            <activation>
                <property>
                    <name>env.GITHUB_ACTIONS</name>
                    <value>true</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>enforce-docker-tests-in-ci</id>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireProperty>
                                            <property>env.PULSEFLOW_TEST_DOCKER</property>
                                            <message>CI must run Docker integration tests. Set PULSEFLOW_TEST_DOCKER=true.</message>
                                            <regex>true</regex>
                                            <regexMessage>PULSEFLOW_TEST_DOCKER must be 'true' in CI — Docker tests must not be silently skipped.</regexMessage>
                                        </requireProperty>
                                    </rules>
                                    <fail>true</fail>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
