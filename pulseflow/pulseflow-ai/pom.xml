<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.pulseflow</groupId>
        <artifactId>pulseflow</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>pulseflow-ai</artifactId>
    <name>PulseFlow AI</name>
    <description>AI Campaign Copilot — structured LLM outputs under business guardrails</description>

    <dependencies>
        <!-- Internal modules: AI is an optional enhancement layer that calls
             existing profile/campaign application services. It MUST NOT be
             reverse-depended by pulseflow-campaign. -->
        <dependency>
            <groupId>com.pulseflow</groupId>
            <artifactId>pulseflow-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.pulseflow</groupId>
            <artifactId>pulseflow-profile</artifactId>
        </dependency>
        <dependency>
            <groupId>com.pulseflow</groupId>
            <artifactId>pulseflow-campaign</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Azure AI Language PII detection. The client is created only when
             pulseflow.ai.pii.enabled=true and mock mode is disabled. -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-ai-textanalytics</artifactId>
            <version>${azure-ai-textanalytics.version}</version>
        </dependency>
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <!-- Sa-Token: AI controllers resolve the operator id from the login
             session (server authoritative). Only the core API is used at
             compile time; the full starter auto-configuration is activated in
             pulseflow-boot. Version managed by the parent pom. -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
        </dependency>

        <!-- Test only — pure unit tests for guardrail logic. No Spring context,
             no Testcontainers needed. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
