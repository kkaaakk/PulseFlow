# ---- Build artifacts ----
target/
build/
out/
*.class

# ---- IDE / editor ----
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo
*~

# ---- Workspace tooling (not part of the project) ----
.trae/
.workbuddy/
.obsidian/

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Logs ----
*.log
logs/

# ---- Secrets / env (never commit) ----
.env
.env.*
!testing/.env.test.example
*.pem
*.key
*.p12
*.jks

# ---- Local-only runtime data ----
data/
runtime/

# The testing data directory is intentionally versioned; only its generated
# runtime output remains ignored by testing/.gitignore.
!testing/data/
!testing/data/**
