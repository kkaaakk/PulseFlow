# start.ps1 imports existing model/Azure settings from pulseflow-agent/.env.
# Credentials stay in the ignored root .env. The full stack requires a real model.
PULSEFLOW_AGENT_MODEL=deepseek:deepseek-flash
PULSEFLOW_AGENT_BASE_URL=https://api.deepseek.com
PULSEFLOW_AGENT_API_KEY=
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_PII_LANGUAGE=zh-hans
PULSEFLOW_AGENT_MAX_MODEL_REQUESTS=8

# Generated once by start.ps1; retain these values with the database volumes.
PULSEFLOW_AGENT_INTERNAL_TOKEN=
PULSEFLOW_MYSQL_PASSWORD=
PULSEFLOW_MYSQL_ROOT_PASSWORD=
PULSEFLOW_AGENT_DB_PASSWORD=
PULSEFLOW_AGENT_DB_ROOT_PASSWORD=
XXL_JOB_DB_PASSWORD=
XXL_JOB_DB_ROOT_PASSWORD=
XXL_JOB_ACCESS_TOKEN=
XXL_JOB_ADMIN_PASSWORD=

PULSEFLOW_OPERATOR_PASSWORD=pulseflow-local
PULSEFLOW_ADMIN_PASSWORD=pulseflow-admin
PULSEFLOW_WEB_PORT=5173
PULSEFLOW_API_PORT=8080
XXL_JOB_ADMIN_PORT=8081
JAEGER_UI_PORT=16687
PULSEFLOW_MYSQL_PORT=13307
PULSEFLOW_REDIS_PORT=16380
PULSEFLOW_KAFKA_PORT=19093
